{
  "expo": {
    "name": "حروف المغرب",
    "slug": "huroof-al-maghrib",
    "version": "2.8.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "huroofalmaghrib",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#100B24"
    },
    "androidStatusBar": {
      "backgroundColor": "#100B24",
      "barStyle": "light-content",
      "translucent": false
    },
    "androidNavigationBar": {
      "backgroundColor": "#100B24",
      "barStyle": "light-content",
      "enforceContrast": false
    },
    "ios": {
      "supportsTablet": false,
      "bitcode": false,
      "bundleIdentifier": "com.huroofalmaghrib",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "نحتاج إذنك لاستخدام الميكروفون عند تشغيل المحادثة الصوتية في غرفة الأصدقاء",
        "NSUserNotificationsUsageDescription": "نحتاج إذنك لإرسال إشعارات حول المهام اليومية والمكافآت"
      }
    },
    "android": {
      "package": "com.huroofalmaghrib",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#100B24",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-av",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8545693631358718~7364837313",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0D1B2A"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": "https://replit.com/"
      },
      "eas": {
        "projectId": "f1e0f4f2-8408-4fe9-b300-c8d8fb573b4d"
      }
    }
  }
}
