{
  "cli": {
    "version": ">= 18.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://word-master-backend.onrender.com",
        "EXPO_PUBLIC_DOMAIN": "word-master-backend.onrender.com",
        "EXPO_PUBLIC_ADMOB_MODE": "test"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://word-master-backend.onrender.com",
        "EXPO_PUBLIC_DOMAIN": "word-master-backend.onrender.com",
        "EXPO_PUBLIC_ADMOB_MODE": "test"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://word-master-backend.onrender.com",
        "EXPO_PUBLIC_DOMAIN": "word-master-backend.onrender.com",
        "EXPO_PUBLIC_ADMOB_MODE": "production",
        "EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID": "ca-app-pub-8545693631358718/6714680528"
      }
    },
    "production-apk": {
      "extends": "production",
      "autoIncrement": false,
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
