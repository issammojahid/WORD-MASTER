# Copy this file to .env and replace the placeholders using Supabase Dashboard > Connect.
# Use the Session pooler connection string for Render if its outbound network cannot reach the direct IPv6 endpoint.
# URL-encode special characters in the database password. Never commit your real .env.
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<URL_ENCODED_DATABASE_PASSWORD>@<SUPABASE_POOLER_HOST>:5432/postgres?sslmode=verify-full

# Local Node.js backend mode.
NODE_ENV=development

# Backend port; Render sets PORT automatically.
PORT=5000

# December/January events. Enable only after reviewed migrations and backend deployment.
SEASON_2027_ENABLED=false
# Rewarded currency remains off until AdMob SSV is configured and verified on Android.
REWARDED_ADS_ENABLED=false
ADMOB_SSV_AD_UNIT=
ADMOB_SSV_REWARD_ITEM=
ADMOB_SSV_REWARD_AMOUNT=
# Optional private-room voice relay: server-only coturn REST secret, never EXPO_PUBLIC.
VOICE_STUN_URLS=stun:stun.l.google.com:19302
VOICE_TURN_URLS=
VOICE_TURN_SECRET=
